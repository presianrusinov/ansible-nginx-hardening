[Unit]
Description=AI Backend Flask Service
After=network.target

[Service]
User=ansible
WorkingDirectory=/var/www/ai_project
Environment="NLTK_DATA=/usr/local/share/nltk_data"

# Use absolute path (deterministic, no PATH/env expansion issues)
ExecStart=/usr/local/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 --timeout 60 --access-logfile - --error-logfile - app:app

Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target

