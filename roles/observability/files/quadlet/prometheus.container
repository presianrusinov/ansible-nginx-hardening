[Unit]
Description=Prometheus
After=network-online.target

[Container]
Image=quay.io/prometheus/prometheus:latest
Network=host
Volume=/opt/observability/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
Exec=--config.file=/etc/prometheus/prometheus.yml --web.listen-address=127.0.0.1:9090

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
